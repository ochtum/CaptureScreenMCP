{
  "name": "capture-screen",
  "description": "Windows screen capture MCP server (stdio transport)",
  "version": "1.0.0",
  "transport": "stdio",
  "command": "dotnet",
  "args": [
    "run",
    "--project",
    "."
  ],
  "env": {
    "CAPTURE_SCREEN_DEFAULT_DISPLAY": "primary",
    "CAPTURE_SCREEN_OUTPUT_DIR": "C:\\capture_screen",
    "CAPTURE_SCREEN_HIDE_FOREGROUND_WINDOWS_TERMINAL": "1"
  }
}
